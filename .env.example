# Get GEMINI_API_KEY from Google AI Studio (free tier, no card required).
# Get GROQ_API_KEY from console.groq.com (free tier, no card required).

GEMINI_API_KEY=
GROQ_API_KEY=

# Optional model name overrides (defaults to gemini-2.5-flash and llama-3.1-8b-instant)
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.1-8b-instant
